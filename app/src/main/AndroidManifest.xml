<?xml version="1.0" encoding="utf-8"?>
<!--
    Manifiesto de Patitas. Cada Activity declara su tema: así el rol Vendedor se ve en terracota
    y el Administrador en gris pizarra sin cambiar los layouts.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Ingreso con huella (BiometricPrompt) -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Patitas"
        tools:targetApi="35">

        <!-- Transversal -->
        <activity
            android:name=".ui.auth.SplashActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.Patitas.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".ui.auth.WelcomeActivity"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.Patitas.Auth" />
        <activity
            android:name=".ui.auth.LoginActivity"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.Patitas.Auth"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ui.auth.RegisterActivity"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ui.auth.RecoverPasswordActivity"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />

        <!-- Comprador (tema verde azulado por defecto) -->
        <activity
            android:name=".ui.buyer.BuyerHomeActivity"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustPan" />
        <activity
            android:name=".ui.buyer.ProductDetailActivity"
            android:screenOrientation="portrait" />
        <activity
            android:name=".ui.buyer.CheckoutActivity"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ui.buyer.PaymentActivity"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ui.buyer.PaymentResultActivity"
            android:screenOrientation="portrait" />

        <!-- Vendedor -->
        <activity
            android:name=".ui.seller.SellerHomeActivity"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.Patitas.Seller" />
        <activity
            android:name=".ui.seller.ProductFormActivity"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.Patitas.Seller"
            android:windowSoftInputMode="adjustResize" />

        <!-- Administrador -->
        <activity
            android:name=".ui.admin.AdminHomeActivity"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.Patitas.Admin"
            android:windowSoftInputMode="adjustPan" />
        <activity
            android:name=".ui.admin.UserFormActivity"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.Patitas.Admin"
            android:windowSoftInputMode="adjustResize" />
    </application>
</manifest>
