<?xml version="1.0" encoding="utf-8"?>
<!--
    Perfil (C-08 comprador / V-07 vendedor). Una sola estructura:
    cabecera con avatar, tarjeta de datos, tarjeta de tienda (solo vendedor),
    preferencias con MaterialSwitch y opciones de privacidad (Ley 1581).
-->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="@dimen/space_xl">

        <!-- Cabecera -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_header"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingTop="@dimen/space_l"
            android:paddingBottom="@dimen/space_xl">

            <FrameLayout
                android:layout_width="96dp"
                android:layout_height="96dp">

                <TextView
                    android:id="@+id/textAvatar"
                    android:layout_width="@dimen/avatar_l"
                    android:layout_height="@dimen/avatar_l"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_circle_soft"
                    android:gravity="center"
                    android:textColor="@color/on_dark"
                    android:textSize="30sp"
                    android:textStyle="bold" />

                <ImageButton
                    android:id="@+id/buttonPhoto"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_gravity="bottom|end"
                    android:background="@drawable/bg_circle_white"
                    android:contentDescription="@string/action_change_photo"
                    android:padding="8dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_camera"
                    app:tint="?attr/colorPrimary" />
            </FrameLayout>

            <TextView
                android:id="@+id/textName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m"
                android:textColor="@color/on_dark"
                android:textSize="@dimen/text_title"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/textEmail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:alpha="0.85"
                android:textColor="@color/on_dark" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/textRole"
                    style="@style/Widget.Patitas.Badge"
                    android:backgroundTint="@color/scrim_light"
                    android:textColor="@color/on_dark" />

                <TextView
                    android:id="@+id/textStatus"
                    style="@style/Widget.Patitas.Badge"
                    android:layout_marginStart="@dimen/space_s" />
            </LinearLayout>
        </LinearLayout>

        <!-- Invitado: invita a iniciar sesión -->
        <include
            android:id="@+id/guest"
            layout="@layout/layout_empty_state" />

        <LinearLayout
            android:id="@+id/groupProfile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_padding"
            android:paddingEnd="@dimen/screen_padding">

            <!-- Datos personales -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/Widget.Patitas.SectionTitle"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="@string/profile_personal_data" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/buttonEdit"
                    style="@style/Widget.Patitas.Button.Text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_m"
                    android:text="@string/action_edit"
                    app:icon="@drawable/ic_edit"
                    app:iconTint="?attr/colorPrimary" />
            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <include
                        android:id="@+id/rowPhone"
                        layout="@layout/view_setting_row" />

                    <include
                        android:id="@+id/rowDocument"
                        layout="@layout/view_setting_row" />

                    <include
                        android:id="@+id/rowAddress"
                        layout="@layout/view_setting_row" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Datos de la tienda (solo vendedor, RF-PER-06) -->
            <LinearLayout
                android:id="@+id/groupStore"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    style="@style/Widget.Patitas.SectionTitle"
                    android:text="@string/profile_store_data" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <include
                        android:id="@+id/kpiRating"
                        layout="@layout/layout_kpi"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/space_s"
                        android:layout_weight="1" />

                    <include
                        android:id="@+id/kpiSales"
                        layout="@layout/layout_kpi"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_s"
                        android:layout_weight="1" />
                </LinearLayout>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_m">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <include
                            android:id="@+id/rowStoreName"
                            layout="@layout/view_setting_row" />

                        <include
                            android:id="@+id/rowSchedule"
                            layout="@layout/view_setting_row" />

                        <include
                            android:id="@+id/rowDispatch"
                            layout="@layout/view_setting_row" />

                        <include
                            android:id="@+id/rowBank"
                            layout="@layout/view_setting_row" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- Preferencias -->
            <TextView
                style="@style/Widget.Patitas.SectionTitle"
                android:text="@string/profile_preferences" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/space_l"
                    android:paddingEnd="@dimen/space_m">

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchBiometric"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="56dp"
                        android:text="@string/pref_biometric"
                        android:textColor="@color/ink_900" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchNotifications"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:minHeight="56dp"
                        android:text="@string/pref_notifications"
                        android:textColor="@color/ink_900" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchMarketing"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="56dp"
                        android:text="@string/pref_marketing"
                        android:textColor="@color/ink_900" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Privacidad (Ley 1581 de 2012) -->
            <TextView
                style="@style/Widget.Patitas.SectionTitle"
                android:text="@string/profile_privacy" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <include
                        android:id="@+id/rowDownload"
                        layout="@layout/view_setting_row" />

                    <include
                        android:id="@+id/rowDeleteAccount"
                        layout="@layout/view_setting_row" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonLogout"
                style="@style/Widget.Patitas.Button.Outlined"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xl"
                android:text="@string/drawer_logout"
                app:icon="@drawable/ic_logout" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
