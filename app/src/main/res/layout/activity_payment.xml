<?xml version="1.0" encoding="utf-8"?>
<!--
    Pasarela de pagos (C-05): resumen de la compra, dirección de entrega y botón para pagar con
    ePayco. Los medios de pago (tarjeta, PSE, Nequi, Daviplata, efectivo) los muestra el checkout
    de ePayco, así que los datos de la tarjeta nunca pasan por la app (PCI DSS).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:title="@string/payment_title" />

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/progress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:indeterminate="true"
        android:visibility="invisible"
        app:indicatorColor="@color/accent_amber" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/screen_padding">

            <!-- Total a pagar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_header"
                android:orientation="vertical"
                android:padding="@dimen/space_l">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/payment_total_label"
                    android:textAppearance="@style/TextAppearance.Patitas.Overline"
                    android:textColor="@color/buyer_container" />

                <TextView
                    android:id="@+id/textTotal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/on_dark"
                    android:textSize="@dimen/text_display"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/textDetail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/buyer_container"
                    android:textSize="@dimen/text_caption" />
            </LinearLayout>

            <TextView
                style="@style/Widget.Patitas.SectionTitle"
                android:text="@string/payment_summary" />

            <TextView
                android:id="@+id/textItems"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="4dp"
                android:textAppearance="@style/TextAppearance.Patitas.Body" />

            <TextView
                style="@style/Widget.Patitas.SectionTitle"
                android:text="@string/payment_delivery" />

            <TextView
                android:id="@+id/textAddress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:drawablePadding="@dimen/space_s"
                android:textAppearance="@style/TextAppearance.Patitas.Body"
                app:drawableStartCompat="@drawable/ic_location"
                app:drawableTint="?attr/colorPrimary" />

            <TextView
                style="@style/Widget.Patitas.SectionTitle"
                android:text="@string/payment_method" />

            <!-- Medios de pago que ofrece el checkout de ePayco -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_option"
                android:orientation="vertical"
                android:padding="@dimen/space_l">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:drawablePadding="@dimen/space_s"
                    android:gravity="center_vertical"
                    android:text="@string/payment_epayco_title"
                    android:textAppearance="@style/TextAppearance.Patitas.Subtitle"
                    app:drawableStartCompat="@drawable/ic_credit_card"
                    app:drawableTint="?attr/colorPrimary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    android:text="@string/payment_epayco_methods"
                    android:textAppearance="@style/TextAppearance.Patitas.Caption" />
            </LinearLayout>

            <!-- Aviso de modo pruebas -->
            <TextView
                android:id="@+id/textTestMode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_l"
                android:background="@drawable/bg_notice_warning"
                android:padding="@dimen/space_m"
                android:text="@string/payment_test_note"
                android:textSize="@dimen/text_caption" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_l"
                android:drawablePadding="@dimen/space_s"
                android:gravity="center_vertical"
                android:text="@string/payment_security_note"
                android:textAppearance="@style/TextAppearance.Patitas.Caption"
                app:drawableStartCompat="@drawable/ic_shield"
                app:drawableTint="@color/state_success" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_bottom_bar"
        android:padding="@dimen/space_l">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonPay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:icon="@drawable/ic_lock" />
    </LinearLayout>
</LinearLayout>
