<?xml version="1.0" encoding="utf-8"?>
<!-- Ítem de moderación: producto, vendedor, validaciones automáticas y acciones aprobar/rechazar. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/space_m">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/space_m">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <FrameLayout
                android:id="@+id/frameThumb"
                android:layout_width="@dimen/product_thumb"
                android:layout_height="@dimen/product_thumb">

                <ImageView
                    android:id="@+id/imageProduct"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    app:tint="@color/cream_background" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_m"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/textName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:textColor="@color/ink_900"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/textMeta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.Patitas.Caption" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/textPrice"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textAppearance="@style/TextAppearance.Patitas.Price" />

                    <TextView
                        android:id="@+id/textStatus"
                        style="@style/Widget.Patitas.Badge" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/textChecks"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_m"
            android:background="@drawable/bg_notice_info"
            android:lineSpacingMultiplier="1.3"
            android:padding="@dimen/space_m"
            android:textColor="?attr/colorOnPrimaryContainer"
            android:textSize="@dimen/text_caption" />

        <LinearLayout
            android:id="@+id/groupActions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_m"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonReject"
                style="@style/Widget.Patitas.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginEnd="@dimen/space_s"
                android:layout_weight="1"
                android:minHeight="44dp"
                android:text="@string/action_reject"
                android:textColor="@color/state_error"
                app:icon="@drawable/ic_close"
                app:iconTint="@color/state_error"
                app:strokeColor="@color/state_error" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonApprove"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginStart="@dimen/space_s"
                android:layout_weight="1"
                android:minHeight="44dp"
                android:text="@string/action_approve"
                app:backgroundTint="@color/state_success"
                app:icon="@drawable/ic_check"
                app:iconTint="@color/on_dark" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
