<?xml version="1.0" encoding="utf-8"?>
<!--
    Reporte de ventas del Administrador: periodo (ChipGroup), indicadores, gráfico de barras
    (vista personalizada BarChartView con atributos declarados en attrs.xml), ventas por
    categoría y mejores vendedores.
-->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/screen_padding">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupPeriod"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipWeek"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/period_week" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipMonth"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/period_month" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipYear"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/period_year" />
        </com.google.android.material.chip.ChipGroup>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_m"
            android:orientation="horizontal">

            <include
                android:id="@+id/kpiTotal"
                layout="@layout/layout_kpi"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1" />

            <include
                android:id="@+id/kpiOrders"
                layout="@layout/layout_kpi"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_m"
            android:orientation="horizontal">

            <include
                android:id="@+id/kpiTicket"
                layout="@layout/layout_kpi"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1" />

            <include
                android:id="@+id/kpiCommission"
                layout="@layout/layout_kpi"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1" />
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_l">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_l">

                <TextView
                    android:id="@+id/textChartTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.Patitas.Subtitle" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/report_chart_caption"
                    android:textAppearance="@style/TextAppearance.Patitas.Caption" />

                <co.patitas.tienda.ui.common.BarChartView
                    android:id="@+id/chart"
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:layout_marginTop="@dimen/space_m"
                    app:chartBarColor="@color/admin_secondary"
                    app:chartCornerRadius="6dp"
                    app:chartHighlightColor="@color/accent_amber"
                    app:chartLabelColor="@color/ink_600" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            style="@style/Widget.Patitas.SectionTitle"
            android:text="@string/report_by_category" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:id="@+id/containerCategories"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_l" />
        </com.google.android.material.card.MaterialCardView>

        <TextView
            style="@style/Widget.Patitas.SectionTitle"
            android:text="@string/report_top_sellers" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:id="@+id/containerSellers"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_l" />
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonExport"
            style="@style/Widget.Patitas.Button.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xl"
            android:text="@string/action_export_csv"
            app:icon="@drawable/ic_download" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
