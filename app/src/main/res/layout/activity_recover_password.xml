<?xml version="1.0" encoding="utf-8"?>
<!--
    Recuperación de contraseña (RF-AUT-04). Dos estados en la misma pantalla:
    formulario (groupForm) y confirmación (groupSent); el código alterna su visibilidad.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:title="@string/recover_title" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="@dimen/screen_padding">

            <FrameLayout
                android:layout_width="104dp"
                android:layout_height="104dp"
                android:layout_marginTop="@dimen/space_xl"
                android:background="@drawable/bg_circle_container">

                <ImageView
                    android:id="@+id/imageState"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_lock"
                    app:tint="?attr/colorPrimary" />
            </FrameLayout>

            <!-- Estado 1: formulario -->
            <LinearLayout
                android:id="@+id/groupForm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xl"
                    android:gravity="center"
                    android:text="@string/recover_heading"
                    android:textAppearance="@style/TextAppearance.Patitas.Headline" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_s"
                    android:gravity="center"
                    android:text="@string/recover_description"
                    android:textAppearance="@style/TextAppearance.Patitas.Body" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/inputEmail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xl"
                    android:hint="@string/field_email"
                    app:startIconDrawable="@drawable/ic_email">

                    <com.google.android.material.textfield.TextInputEditText
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:autofillHints="emailAddress"
                        android:inputType="textEmailAddress" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/buttonSend"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_l"
                    android:text="@string/action_send_link" />
            </LinearLayout>

            <!-- Estado 2: enlace enviado -->
            <LinearLayout
                android:id="@+id/groupSent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xl"
                    android:gravity="center"
                    android:text="@string/recover_sent_heading"
                    android:textAppearance="@style/TextAppearance.Patitas.Headline" />

                <TextView
                    android:id="@+id/textSentDetail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_s"
                    android:gravity="center"
                    android:textAppearance="@style/TextAppearance.Patitas.Body" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_l"
                    android:background="@drawable/bg_notice_info"
                    android:drawablePadding="@dimen/space_s"
                    android:padding="@dimen/space_m"
                    android:text="@string/recover_security_note"
                    android:textAppearance="@style/TextAppearance.Patitas.Caption"
                    android:textColor="?attr/colorOnPrimaryContainer"
                    app:drawableStartCompat="@drawable/ic_info"
                    app:drawableTint="?attr/colorPrimary" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/buttonBackToLogin"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xl"
                    android:text="@string/action_back_to_login" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/buttonResend"
                    style="@style/Widget.Patitas.Button.Text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:text="@string/action_resend" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
