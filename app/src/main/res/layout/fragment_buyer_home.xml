<?xml version="1.0" encoding="utf-8"?>
<!-- Inicio del Comprador (C-01): ubicación, búsqueda, banner, categorías y tiendas cercanas. -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="@dimen/space_xl">

        <!-- Cabecera con curva inferior (drawable bg_header) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_header"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_padding"
            android:paddingEnd="@dimen/screen_padding"
            android:paddingBottom="@dimen/space_xl">

            <TextView
                android:id="@+id/textGreeting"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/on_dark"
                android:textSize="@dimen/text_title"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/textLocation"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:drawablePadding="@dimen/space_xs"
                android:gravity="center_vertical"
                android:text="@string/home_location"
                android:textColor="@color/buyer_container"
                android:textSize="@dimen/text_body"
                app:drawableStartCompat="@drawable/ic_location"
                app:drawableTint="@color/accent_amber" />

            <!-- Caja de búsqueda: abre el catálogo -->
            <LinearLayout
                android:id="@+id/boxSearch"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height"
                android:layout_marginTop="@dimen/space_l"
                android:background="@drawable/bg_search"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/space_l"
                android:paddingEnd="@dimen/space_m">

                <ImageView
                    android:layout_width="@dimen/icon_m"
                    android:layout_height="@dimen/icon_m"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_search"
                    app:tint="@color/ink_400" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_m"
                    android:layout_weight="1"
                    android:text="@string/search_hint"
                    android:textColor="@color/ink_400" />

                <ImageView
                    android:layout_width="@dimen/icon_m"
                    android:layout_height="@dimen/icon_m"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_camera"
                    app:tint="?attr/colorPrimary" />
            </LinearLayout>
        </LinearLayout>

        <!-- Banner promocional -->
        <LinearLayout
            android:id="@+id/banner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/screen_padding"
            android:layout_marginTop="@dimen/space_l"
            android:layout_marginEnd="@dimen/screen_padding"
            android:background="@drawable/bg_banner"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="@dimen/space_l">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/banner_overline"
                    android:textAppearance="@style/TextAppearance.Patitas.Overline"
                    android:textColor="@color/seller_container" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    android:text="@string/banner_title"
                    android:textColor="@color/on_dark"
                    android:textSize="@dimen/text_title"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_s"
                    android:text="@string/banner_code"
                    android:textColor="@color/seller_container"
                    android:textSize="@dimen/text_caption" />
            </LinearLayout>

            <FrameLayout
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:background="@drawable/bg_circle_soft">

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_pets"
                    app:tint="@color/on_dark" />
            </FrameLayout>
        </LinearLayout>

        <TextView
            style="@style/Widget.Patitas.SectionTitle"
            android:layout_marginStart="@dimen/screen_padding"
            android:text="@string/home_categories" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerCategories"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:orientation="horizontal"
            android:paddingStart="@dimen/screen_padding"
            android:paddingEnd="@dimen/screen_padding"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/screen_padding"
            android:paddingEnd="@dimen/space_s">

            <TextView
                style="@style/Widget.Patitas.SectionTitle"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="@string/home_nearby" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonSeeAll"
                style="@style/Widget.Patitas.Button.Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m"
                android:text="@string/action_see_all" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerNearby"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"
            android:paddingStart="14dp"
            android:paddingEnd="14dp" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
