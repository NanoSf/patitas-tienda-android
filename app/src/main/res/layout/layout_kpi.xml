<?xml version="1.0" encoding="utf-8"?>
<!-- Tarjeta de indicador (KPI) usada en los paneles del vendedor, el administrador y el reporte. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.Patitas.Card.Kpi"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/space_l">

        <ImageView
            android:id="@+id/imageKpiIcon"
            android:layout_width="@dimen/icon_m"
            android:layout_height="@dimen/icon_m"
            android:importantForAccessibility="no"
            app:tint="?attr/colorPrimary" />

        <TextView
            android:id="@+id/textKpiValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s"
            android:textColor="?attr/colorOnPrimaryContainer"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textKpiLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Patitas.Caption"
            android:textColor="?attr/colorOnPrimaryContainer" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
