<?xml version="1.0" encoding="utf-8"?>
<!-- Fila de alerta de stock bajo (se infla desde el código). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="@dimen/space_l"
    android:paddingTop="@dimen/space_s"
    android:paddingEnd="@dimen/space_l"
    android:paddingBottom="@dimen/space_s">

    <ImageView
        android:id="@+id/imageIcon"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_info"
        app:tint="@color/state_warning" />

    <TextView
        android:id="@+id/textName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_m"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/ink_900" />

    <TextView
        android:id="@+id/textValue"
        style="@style/Widget.Patitas.Badge"
        android:layout_marginStart="@dimen/space_s" />
</LinearLayout>
