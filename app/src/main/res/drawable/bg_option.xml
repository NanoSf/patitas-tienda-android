<?xml version="1.0" encoding="utf-8"?>
<!-- selector de estados para las opciones de pago y envío (RadioButton):
     seleccionada = borde de 2 dp del color del rol y relleno suave; sin seleccionar = borde arena. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/radius_m" />
            <solid android:color="?attr/colorPrimaryContainer" />
            <stroke android:width="2dp" android:color="?attr/colorPrimary" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/radius_m" />
            <solid android:color="@color/surface_white" />
            <stroke android:width="1dp" android:color="@color/border_sand" />
        </shape>
    </item>
</selector>
