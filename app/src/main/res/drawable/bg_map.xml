<?xml version="1.0" encoding="utf-8"?>
<!-- Mapa ilustrado con layer-list (manzanas, parques y radio de entrega).
     En la versión con backend se reemplaza por Google Maps. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/radius_l" />
            <solid android:color="#E8ECE4" />
        </shape>
    </item>
    <item android:left="14dp" android:top="14dp" android:width="70dp" android:height="54dp">
        <shape android:shape="rectangle"><corners android:radius="4dp" /><solid android:color="@color/surface_white" /></shape>
    </item>
    <item android:left="96dp" android:top="14dp" android:width="90dp" android:height="54dp">
        <shape android:shape="rectangle"><corners android:radius="4dp" /><solid android:color="@color/surface_white" /></shape>
    </item>
    <item android:left="198dp" android:top="14dp" android:width="80dp" android:height="54dp">
        <shape android:shape="rectangle"><corners android:radius="4dp" /><solid android:color="#CFE6C8" /></shape>
    </item>
    <item android:left="14dp" android:top="80dp" android:width="70dp" android:height="70dp">
        <shape android:shape="rectangle"><corners android:radius="4dp" /><solid android:color="#CFE6C8" /></shape>
    </item>
    <item android:left="96dp" android:top="80dp" android:width="90dp" android:height="70dp">
        <shape android:shape="rectangle"><corners android:radius="4dp" /><solid android:color="@color/surface_white" /></shape>
    </item>
    <item android:left="198dp" android:top="80dp" android:width="80dp" android:height="70dp">
        <shape android:shape="rectangle"><corners android:radius="4dp" /><solid android:color="@color/surface_white" /></shape>
    </item>
    <item android:gravity="center" android:width="96dp" android:height="96dp">
        <shape android:shape="oval">
            <solid android:color="#3313675F" />
            <stroke android:width="1dp" android:color="#8013675F" />
        </shape>
    </item>
</layer-list>
