<?xml version="1.0" encoding="utf-8"?>
<!--
    Estilos reutilizables de Patitas. Se aplican por defecto desde el tema
    (materialButtonStyle, textInputStyle, ...) o explícitamente con style="@style/...".
    Todos reemplazan las propiedades por defecto de Material: radios, alturas, colores y tipografía.
-->
<resources>

    <!-- ===================== Formas ===================== -->
    <style name="ShapeAppearance.Patitas.Small" parent="ShapeAppearance.Material3.SmallComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/radius_s</item>
    </style>

    <style name="ShapeAppearance.Patitas.Medium" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/radius_m</item>
    </style>

    <style name="ShapeAppearance.Patitas.Large" parent="ShapeAppearance.Material3.LargeComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/radius_l</item>
    </style>

    <style name="ShapeAppearance.Patitas.Circle" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <!-- Solo las esquinas superiores redondeadas (imagen de las tarjetas de producto) -->
    <style name="ShapeAppearance.Patitas.TopRounded" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">@dimen/radius_l</item>
        <item name="cornerSizeTopRight">@dimen/radius_l</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

    <!-- ===================== Tipografía ===================== -->
    <style name="TextAppearance.Patitas.Display" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:textSize">@dimen/text_display</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/ink_900</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="TextAppearance.Patitas.Headline" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textSize">@dimen/text_headline</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/ink_900</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="TextAppearance.Patitas.Title" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textSize">@dimen/text_title</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/ink_900</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="TextAppearance.Patitas.Subtitle" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textSize">@dimen/text_subtitle</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/ink_900</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="TextAppearance.Patitas.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textColor">@color/ink_600</item>
        <item name="android:lineSpacingMultiplier">1.15</item>
    </style>

    <style name="TextAppearance.Patitas.Caption" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textSize">@dimen/text_caption</item>
        <item name="android:textColor">@color/ink_400</item>
    </style>

    <style name="TextAppearance.Patitas.Price" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textSize">@dimen/text_subtitle</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?attr/colorPrimary</item>
    </style>

    <style name="TextAppearance.Patitas.Overline" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">@color/ink_400</item>
    </style>

    <style name="TextAppearance.Patitas.Button" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- Título de la Toolbar en blanco sobre el color del rol -->
    <style name="TextAppearance.Patitas.ToolbarTitle" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textSize">19sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/on_dark</item>
    </style>

    <!-- ===================== Botones ===================== -->
    <style name="Widget.Patitas.Button" parent="Widget.Material3.Button">
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">@dimen/radius_m</item>
        <item name="backgroundTint">?attr/colorPrimary</item>
        <item name="android:textColor">@color/on_dark</item>
        <item name="android:textAppearance">@style/TextAppearance.Patitas.Button</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">10dp</item>
    </style>

    <style name="Widget.Patitas.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">@dimen/radius_m</item>
        <item name="strokeColor">?attr/colorPrimary</item>
        <item name="strokeWidth">1.5dp</item>
        <item name="android:textColor">?attr/colorPrimary</item>
        <item name="iconTint">?attr/colorPrimary</item>
        <item name="android:textAppearance">@style/TextAppearance.Patitas.Button</item>
        <item name="iconGravity">textStart</item>
    </style>

    <style name="Widget.Patitas.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:textColor">?attr/colorPrimary</item>
        <item name="android:textAppearance">@style/TextAppearance.Patitas.Button</item>
    </style>

    <!-- Botón de acción destructiva (eliminar, suspender) -->
    <style name="Widget.Patitas.Button.Danger">
        <item name="backgroundTint">@color/state_error</item>
    </style>

    <!-- ===================== Campos de texto ===================== -->
    <style name="Widget.Patitas.TextInput" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/input_stroke</item>
        <item name="boxBackgroundColor">@color/surface_white</item>
        <item name="boxCornerRadiusTopStart">@dimen/radius_m</item>
        <item name="boxCornerRadiusTopEnd">@dimen/radius_m</item>
        <item name="boxCornerRadiusBottomStart">@dimen/radius_m</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/radius_m</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="hintTextColor">?attr/colorPrimary</item>
        <item name="startIconTint">@color/ink_400</item>
        <item name="endIconTint">@color/ink_400</item>
    </style>

    <style name="Widget.Patitas.TextInput.Dropdown" parent="Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu">
        <item name="boxStrokeColor">@color/input_stroke</item>
        <item name="boxBackgroundColor">@color/surface_white</item>
        <item name="boxCornerRadiusTopStart">@dimen/radius_m</item>
        <item name="boxCornerRadiusTopEnd">@dimen/radius_m</item>
        <item name="boxCornerRadiusBottomStart">@dimen/radius_m</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/radius_m</item>
        <item name="hintTextColor">?attr/colorPrimary</item>
    </style>

    <!-- ===================== Tarjetas ===================== -->
    <style name="Widget.Patitas.Card" parent="Widget.Material3.CardView.Outlined">
        <item name="cardCornerRadius">@dimen/radius_l</item>
        <item name="cardBackgroundColor">@color/surface_white</item>
        <item name="strokeColor">@color/border_sand</item>
        <item name="strokeWidth">@dimen/card_stroke</item>
        <item name="cardElevation">0dp</item>
    </style>

    <!-- Tarjeta de indicador (KPI) con fondo del contenedor del rol -->
    <style name="Widget.Patitas.Card.Kpi">
        <item name="cardBackgroundColor">?attr/colorPrimaryContainer</item>
        <item name="strokeWidth">0dp</item>
    </style>

    <!-- ===================== Chips ===================== -->
    <style name="Widget.Patitas.Chip" parent="Widget.Material3.Chip.Filter">
        <item name="chipBackgroundColor">@color/chip_background</item>
        <item name="chipStrokeColor">@color/chip_stroke</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="android:textColor">@color/chip_text</item>
        <item name="chipCornerRadius">20dp</item>
        <item name="checkedIconVisible">false</item>
        <item name="android:textSize">13sp</item>
    </style>

    <!-- ===================== Barras de navegación ===================== -->
    <style name="Widget.Patitas.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="android:background">?attr/colorPrimary</item>
        <item name="titleTextAppearance">@style/TextAppearance.Patitas.ToolbarTitle</item>
        <item name="subtitleTextColor">@color/on_dark</item>
        <item name="navigationIconTint">@color/on_dark</item>
    </style>

    <style name="Widget.Patitas.BottomNav" parent="Widget.Material3.BottomNavigationView">
        <item name="backgroundTint">@color/surface_white</item>
        <item name="itemIconTint">@color/nav_item_tint</item>
        <item name="itemTextColor">@color/nav_item_tint</item>
        <item name="labelVisibilityMode">labeled</item>
        <item name="itemActiveIndicatorStyle">@style/Widget.Patitas.BottomNav.Indicator</item>
    </style>

    <style name="Widget.Patitas.BottomNav.Indicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">?attr/colorPrimaryContainer</item>
    </style>

    <style name="Widget.Patitas.ExtendedFab" parent="Widget.Material3.ExtendedFloatingActionButton.Icon.Primary">
        <item name="backgroundTint">?attr/colorPrimary</item>
        <item name="android:textColor">@color/on_dark</item>
        <item name="iconTint">@color/on_dark</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.Patitas.Large</item>
    </style>

    <!-- ===================== Textos especiales ===================== -->
    <!-- Badge de estado: el fondo y el color se cambian desde el código según el estado -->
    <style name="Widget.Patitas.Badge" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:paddingTop">3dp</item>
        <item name="android:paddingBottom">3dp</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:background">@drawable/bg_badge</item>
    </style>

    <!-- Encabezado de sección dentro de una pantalla -->
    <style name="Widget.Patitas.SectionTitle" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">@dimen/space_xl</item>
        <item name="android:layout_marginBottom">@dimen/space_m</item>
        <item name="android:textAppearance">@style/TextAppearance.Patitas.Subtitle</item>
    </style>

    <!-- Fila de resumen (etiqueta a la izquierda, valor a la derecha) -->
    <style name="Widget.Patitas.SummaryLabel" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:textAppearance">@style/TextAppearance.Patitas.Body</item>
    </style>

    <style name="Widget.Patitas.SummaryValue" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textAppearance">@style/TextAppearance.Patitas.Body</item>
        <item name="android:textColor">@color/ink_900</item>
    </style>

    <!-- Opción de método de pago: RadioButton sin círculo por defecto, fondo selector e indicador propio -->
    <style name="Widget.Patitas.PaymentOption" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginBottom">@dimen/space_s</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:background">@drawable/bg_option</item>
        <item name="android:button">@null</item>
        <item name="android:drawablePadding">@dimen/space_m</item>
        <item name="android:paddingStart">@dimen/space_l</item>
        <item name="android:paddingEnd">@dimen/space_l</item>
        <item name="android:textColor">@color/ink_900</item>
        <item name="android:textSize">15sp</item>
        <item name="drawableEndCompat">@drawable/radio_indicator</item>
    </style>

    <!-- Divisor horizontal fino -->
    <style name="Widget.Patitas.Divider" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:background">@color/border_sand</item>
    </style>
</resources>
